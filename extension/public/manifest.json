{
  "manifest_version": 3,
  "name": "Trail",
  "short_name": "Trail",
  "version": "0.12.0",
  "description": "__MSG_description__",
  "default_locale": "pt_BR",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Trail"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*.service-now.com/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "src/diff/index.html",
        "src/sidepanel/index.html",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-icons": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdToggleIcons__"
    }
  }
}
